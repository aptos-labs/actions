{
  "name": "prune-github-workflow-runs",
  "version": "0.0.0",
  "author": "",
  "private": true,
  "homepage": "https://github.com/aptos-labs/actions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aptos-labs/actions.git"
  },
  "bugs": {
    "url": "https://github.com/aptos-labs/actions/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "audit": "pnpm audit",
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint . -c ./.github/linters/.eslintrc.yml",
    "package": "pnpm ncc build src/index.ts -o dist --source-map",
    "package:watch": "pnpm run package -- --watch",
    "test": "pnpm jest",
    "all": "pnpm run format:write && pnpm run lint && pnpm run test && pnpm run coverage && pnpm run package"
  },
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@actions/glob": "^0.4.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@^7.0.0": "7.29.7",
      "@babel/helpers@^7.0.0": "7.29.7",
      "@babel/runtime@^7.0.0": "7.29.7",
      "@octokit/endpoint@^9.0.0": "9.0.6",
      "@octokit/plugin-paginate-rest@^9.0.0": "9.2.2",
      "@octokit/request-error@^5.0.0": "5.1.1",
      "@octokit/request@^8.0.0": "8.4.1",
      "ajv@^6.0.0": "6.15.0",
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^2.0.0": "2.1.7",
      "braces": "3.0.3",
      "browserslist": "4.29.0",
      "cross-spawn": "7.0.6",
      "flatted": "3.4.4",
      "js-yaml@^3.0.0": "3.15.2",
      "js-yaml@^4.0.0": "4.3.2",
      "lodash": "4.18.1",
      "micromatch": "4.0.8",
      "minimatch@^3.0.0": "3.1.5",
      "minimatch@^9.0.0": "9.0.9",
      "picomatch@^2.0.0": "2.3.2",
      "undici": "6.28.1"
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.6",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-jsonc": "^2.15.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.4"
  }
}
